{
  "name": "mofeed-mini-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo of 30 Arabic-first mini web apps, web-first with a path to mobile via Capacitor.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "scan:audit": "pnpm audit --prod || true",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:semgrep": "semgrep --config=auto --error || true",
    "scan:osv": "osv-scanner --lockfile=pnpm-lock.yaml || true",
    "scan:licenses": "node scripts/scan-licenses.mjs",
    "scan:all": "pnpm scan:audit && pnpm scan:secrets && pnpm scan:licenses && pnpm scan:semgrep && pnpm scan:osv",
    "preview": "pnpm -r --filter './apps/*' preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@google/genai": "^2.3.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}

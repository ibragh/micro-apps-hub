# Mofeed Mini Apps — example environment variables.
# Copy to .env.local at each app root if you need to override.
# All public values must be prefixed with VITE_ to be exposed to the browser.

# Analytics — leave empty to disable.
# We default to Plausible (privacy-friendly, cookieless).
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_HOST=https://plausible.io

# Hub canonical origin, used in SEO meta tags.
VITE_SITE_ORIGIN=https://mofeed-mini-apps.example

# Optional feature flags
VITE_ENABLE_SUPPORT_LINK=false
VITE_ENABLE_PRO_PLACEHOLDER=false

# Used by apps/hub to build per-app subdomain links.
# Example: "mofeed-mini-apps.example" → hub cards link to https://<slug>.mofeed-mini-apps.example/
VITE_SUBDOMAIN_BASE=
